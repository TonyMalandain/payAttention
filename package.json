{
  "name": "payattention",
  "private": true,
  "version": "0.0.0",
  "description": "GNOME Shell extension: alerts for the meetings that matter (dev tooling only; never packed)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "build": "bash scripts/build.sh",
    "test:helper": "node --test \"tests/helper/**/*.test.js\" \"tests/ai/**/*.test.js\"",
    "smoke": "bash scripts/smoke.sh",
    "install:local": "bash scripts/install.sh",
    "uninstall:local": "bash scripts/uninstall.sh",
    "preview": "gjs -m \"${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/payattention@tonymalandain.github.io/preview/main.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
